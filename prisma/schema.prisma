generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PriceSegment {
  high
  medium
  low
}

model Listing {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  city          String?
  country       String?
  isAvailable   Boolean?
  pricePerNight Int?
  priceSegment  PriceSegment?
  sourceId      String       @unique
  metadata      Json?        // For unmapped fields from new JSON sources

  @@index([name])
  @@index([city])
  @@index([country])
  @@index([isAvailable])
  @@index([pricePerNight])
  @@index([name, city, country])
}
